<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gold_quote_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gold_quote_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/gold_quote_basis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_gold_quote"
            android:textColor="#FFE08A"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_gold_quote_unit"
            android:textColor="#A3A3A3"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/gold_quote_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="15sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:text="@string/widget_gold_quote_unavailable_price"
        android:textColor="#F2F2F5"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gold_quote_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_gold_quote_unavailable"
        android:textColor="#A3A3A3"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gold_quote_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#A3A3A3"
        android:textSize="10sp" />
</LinearLayout>
