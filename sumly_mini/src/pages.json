{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "@wot-ui/ui/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "记金"
      }
    },
    {
      "path": "pages/holdings/index",
      "style": {
        "navigationBarTitleText": "持仓"
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/holdings/edit",
      "style": {
        "navigationBarTitleText": "添加黄金"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "记金",
    "navigationBarBackgroundColor": "#1b1b1d",
    "backgroundColor": "#1b1b1d",
    "backgroundColorTop": "#1b1b1d",
    "backgroundColorBottom": "#1b1b1d"
  }
}